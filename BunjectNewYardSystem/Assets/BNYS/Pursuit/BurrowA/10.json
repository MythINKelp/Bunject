    {
      "Name": "KevinDiscovered",
      "Lines": [
        {
          "Headshot": "PaqueretteSurprised",
          "Content": "<color=$ophelineColor>Ophéline</color>?"
        },
        {
          "Headshot": "PaqueretteSurprised",
          "Content": "What are you doing here?"
        },
        {
          "Headshot": "OphelineIdle",
          "Content": "Oh hey <color=$pinkColor>Pâquerette</color>!"
        },
        {
          "Headshot": "OphelineIdle",
          "Content": "So this is where <color=$bunburrowColor>Kevin</color> has been hiding after all those years..."
        },
        {
          "Headshot": "PaqueretteSurprised",
          "Content": "Who's <color=$bunburrowColor>Kevin</color>?"
        },
        {
          "Headshot": "OphelineSmirk",
          "Content": "Well..."
        },
        {
          "Headshot": "OphelineIdle",
          "Content": "A few years back <color=$bunburrowColor>Kevin</color> lurked in the deepest reaches of the <color=$ghostlyColor>Spooky Bunburrow</color>..."
        },
        {
          "Headshot": "OphelineIdle",
          "Content": "He was unlike the others and refused the <color=$bunburrowColor>Pilgrimage</color>..."
        },
        {
          "Headshot": "OphelineSigh",
          "Content": "Until one day, he mysteriously <color=$bunburrowColor>vanished</color>."
        },
        {
          "Headshot": "OphelineSigh",
          "Content": "Another bunny pillar was put in his place to cover up his disappearance but~"
        },
        {
          "Headshot": "OphelineSmirk",
          "Content": "There were still many, like me, who never forgot about <color=$bunburrowColor>Kevin</color>."
        },
        {
          "Headshot": "OphelineIdle",
          "Content": "And here, at last, we have found <color=$bunburrowColor>Kevin</color> in his lair."
        },
        {
          "Headshot": "PaqueretteHappy",
          "Content": "That's so cool!"
        }
      ],
      "RequiredCaptures": 0,
      "RequiredBabies": 0,
      "RequiredHomeCaptures": 0,
      "ShouldOnlyPlayOnce": true
    },
